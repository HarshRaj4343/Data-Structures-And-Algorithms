# Compiled binaries (extensionless executables next to .cpp sources).
# Ignore every extensionless file under src/, but keep directories and any
# file that has an extension. Note: an extensionless file you DO want tracked
# (e.g. a Makefile under src/) needs `git add -f`.
src/**/*
!src/**/
!src/**/*.*

